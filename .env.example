# Flashpoint Web - Environment Template
# Copy to .env and fill in required values.
#
# Production:  docker compose up -d
# Development: docker compose -f docker-compose.dev.yml up -d --build

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
FLASHPOINT_HOST_PATH=/path/to/Flashpoint
JWT_SECRET=replace-with-a-secure-random-string

# ---------------------------------------------------------------------------
# Container Image (production only)
# ---------------------------------------------------------------------------
# Override image tag (image from Docker Hub: darkraise/flashpoint-web)
# IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Port (host mapping)
# ---------------------------------------------------------------------------
# Maps a host port to the container, which serves both the UI and the API
# on port 3100
WEB_PORT=80

# ---------------------------------------------------------------------------
# Data Storage
# ---------------------------------------------------------------------------
# Host path for persistent data (user.db, local flashpoint.sqlite copy)
DATA_PATH=./data

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Host path for logs (backend.log, client-errors.log)
LOGS_PATH=./logs
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# OpenTelemetry (optional)
# ---------------------------------------------------------------------------
# Enable OTEL for distributed tracing and metrics
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_API_KEY=your-api-key-here
OTEL_SERVICE_NAME=flashpoint-web
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true
# OTEL_METRICS_EXPORT_INTERVAL=60000
# OTEL_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Container User Permissions
# ---------------------------------------------------------------------------
# Match your host user to avoid bind-mount permission issues
# Run 'id -u' and 'id -g' on your host to find your values
# PUID=1000
# PGID=1000

# ---------------------------------------------------------------------------
# Application settings
# ---------------------------------------------------------------------------
NODE_ENV=production
TZ=UTC
# Allowed CORS origin(s), comma-separated. Same-origin requests are always
# allowed, so this only matters when the UI is served from a different origin or
# behind a proxy that rewrites Host. Default ports are normalized, so
# http://host:80 and http://host are equivalent; write out non-default ports.
# Example with a LAN address and a public domain:
#   DOMAIN=http://192.168.0.118,https://flashpoint.example.com
DOMAIN=http://localhost:80

# ---------------------------------------------------------------------------
# Database Performance Optimization (for network storage)
# ---------------------------------------------------------------------------
# Enable if FLASHPOINT_HOST_PATH is on a network share (SMB/NFS)
# Copies flashpoint.sqlite to local Docker volume for faster access
ENABLE_LOCAL_DB_COPY=false

# SQLite performance tuning
# SQLITE_CACHE_SIZE: Negative value = KB, -64000 = 64MB cache
SQLITE_CACHE_SIZE=-64000
# SQLITE_MMAP_SIZE: Memory-mapped I/O size in bytes (256MB default)
SQLITE_MMAP_SIZE=268435456

# Cache pre-warming (loads common queries on startup)
ENABLE_CACHE_PREWARM=true

# ---------------------------------------------------------------------------
# Auth & Rate Limiting
# ---------------------------------------------------------------------------
# JWT_EXPIRES_IN=1h
# BCRYPT_SALT_ROUNDS=10
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# HOME_RECENT_HOURS=24
# ENABLE_CGI=false
# Serve the built frontend from the backend (on by default in production)
# SERVE_FRONTEND=true

